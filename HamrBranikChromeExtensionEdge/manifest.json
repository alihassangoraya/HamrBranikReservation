{
    "manifest_version": 3,
    "name": "My Extension",
    "version": "1.0",
    "permissions": ["activeTab", "storage"],
    "action": {
      "default_popup": "popup.html"
    },
    "content_scripts": [
      {
        "matches": ["https://hodiny.hamrsport.cz/*"],
        "js": ["jquery.min.js", "content.js"],
        "run_at": "document_end"
      }
    ]
  }
  